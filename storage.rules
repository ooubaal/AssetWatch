rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Enterprise Security: Strictly allow access ONLY to authenticated users
    // File size capped at 10MB, strictly limiting to images and documents
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
                    (request.resource == null || (
                      request.resource.size < 10 * 1024 * 1024 &&
                      (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf')
                    ));
    }
  }
}

