rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Only authenticated users can read and write files, with max size limit of 5MB
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                   && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
